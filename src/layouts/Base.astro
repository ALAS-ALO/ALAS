---
import '../styles/global.css';
import meta from '../i18n/meta.json';
type Lang = 'es' | 'en' | 'gl';
interface Props { lang: Lang; title?: string; description?: string; paths?: Record<Lang, string>; noindex?: boolean; home?: boolean; }
const { lang, title, description, paths: given, noindex, home } = Astro.props;
const m = meta[lang];
const paths = given ?? { es: '/', en: '/en/', gl: '/gl/' };
const site = Astro.site ?? new URL('https://alas.lopezoteroadrian.workers.dev');
const url = (p: string) => new URL(p, site).href;
const t = title ?? m.title, d = description ?? m.description;
// structured data for search engines: who is behind the site and what it is
const ld = home ? JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'ProfessionalService', '@id': url('/#alas'), name: 'ALAS', alternateName: ['ALAS Studio', 'ALAS Space'], url: url(paths[lang]), logo: url('/apple-touch-icon.png'), image: url('/og.png'), description: d,
      founder: { '@type': 'Person', name: 'Adrián López Otero', jobTitle: lang === 'en' ? 'Architect' : 'Arquitecto' },
      address: { '@type': 'PostalAddress', addressLocality: 'Vigo', addressRegion: 'Pontevedra', addressCountry: 'ES' }, areaServed: { '@type': 'Country', name: 'España' },
      knowsAbout: ['Arquitectura', 'BIM', 'Rehabilitación', 'Automatización', 'Inteligencia artificial aplicada a la arquitectura'] },
    { '@type': 'WebSite', '@id': url('/#web'), url: url('/'), name: 'ALAS', inLanguage: lang, publisher: { '@id': url('/#alas') } },
  ],
}) : '';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t}</title>
    <meta name="description" content={d} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url(paths[lang])} />}
    {!noindex && Object.entries(paths).map(([l, p]) => <link rel="alternate" hreflang={l} href={url(p)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={url(paths.es)} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ALAS" />
    <meta property="og:title" content={t} />
    <meta property="og:description" content={d} />
    <meta property="og:url" content={url(paths[lang])} />
    <meta property="og:image" content={url('/og.png')} />
    <meta property="og:locale" content={m.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {ld && <script type="application/ld+json" set:html={ld} />}
    <link rel="preload" href="/fonts/archivo-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
